@model WebApplication2.Models.News
@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            @* --- NỘI DUNG CHÍNH --- *@
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-4" style="font-size: 0.9rem;">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("News")" class="text-decoration-none text-muted">Tin tức</a></li>
                    <li class="breadcrumb-item active fw-bold text-dark">Chi tiết</li>
                </ol>
            </nav>

            <h1 class="fw-bold mb-3" style="color: #333; line-height: 1.3;">@Model.Title</h1>

            <div class="d-flex align-items-center text-muted small mb-4">
                <span class="me-3"><i class="fa-regular fa-calendar me-1"></i> @Model.CreatedDate.ToString("dd/MM/yyyy")</span>
                <span><i class="fa-solid fa-user me-1"></i> Bởi Admin ShopNH</span>
            </div>

            <div class="news-content" style="font-size: 1.1rem; line-height: 1.8; color: #444;">
                @* Hiển thị ảnh đại diện bài viết *@
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Url.Content(Model.ImagePath)" class="img-fluid rounded-4 mb-4 shadow-sm w-100" style="max-height: 500px; object-fit: cover;">
                }

                @* Mô tả ngắn *@
                <p class="fw-bold fs-5 mb-4" style="color: #555; border-left: 4px solid #ff8c00; padding-left: 15px;">
                    @Model.ShortDescription
                </p>

                @* Nội dung chi tiết (Sử dụng Html.Raw để hiển thị được định dạng HTML nếu có) *@
            <div class="detail-body">
                @Html.Raw(Model.Content)
            </div>
            </div>

            @* --- PHẦN TIN LIÊN QUAN --- *@
            <div class="mt-5 pt-5 border-top">
                <h4 class="fw-bold mb-4">TIN TỨC LIÊN QUAN</h4>
                <div class="row">
                    @foreach (var item in (List<WebApplication2.Models.News>)ViewBag.RelatedNews)
                    {
                        <div class="col-md-4 mb-3">
                            <a href="@Url.Action("Details", "News", new { area = "", id = item.Id })" class="text-decoration-none">
                                <div class="card border-0 h-100 shadow-none bg-transparent">
                                    @* SỬA TẠI ĐÂY: Kiểm tra ImagePath trước khi gọi Url.Content *@
                                    <img src="@(string.IsNullOrEmpty(item.ImagePath) ? "https://placehold.co/400x250?text=No+Image" : Url.Content(item.ImagePath))"
                                         class="rounded-3 mb-2"
                                         style="height: 120px; width: 100%; object-fit: cover;"
                                         onerror="this.src='https://placehold.co/400x250?text=ShopNH'">

                                    <h6 class="text-dark fw-bold mb-1 text-truncate-2">@item.Title</h6>
                                    <small class="text-muted">@item.CreatedDate.ToString("dd/MM/yyyy")</small>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .detail-body img {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
        margin: 20px 0;
    }
</style>