@model WebApplication2.Models.ResetPasswordViewModel
@{ ViewBag.Title = "Đặt lại mật khẩu"; }

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0" style="border-radius: 25px;">
                <div class="card-header text-center py-4" style="background-color: #ff8c00; color: white;">
                    <h4 class="mb-0 fw-bold"><i class="fa-solid fa-key"></i> ĐẶT LẠI MẬT KHẨU</h4>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Code)
                        @Html.ValidationSummary("", new { @class = "text-danger small" })

                        <div class="mb-3">
                            <label class="fw-bold text-muted small">EMAIL CỦA BẠN</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control shadow-sm", style = "border-radius: 10px;" })
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold text-muted small">MẬT KHẨU MỚI</label>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control shadow-sm", style = "border-radius: 10px;" })
                        </div>

                        <div class="mb-4">
                            <label class="fw-bold text-muted small">XÁC NHẬN MẬT KHẨU</label>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control shadow-sm", style = "border-radius: 10px;" })
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-lg text-white" style="background-color: #ff8c00; border-radius: 12px; font-weight: bold;">CẬP NHẬT MẬT KHẨU</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>