@{ ViewBag.Title = "Thành công"; }

<div class="container mt-5 text-center">
    <div class="card shadow border-0 mx-auto py-5" style="max-width: 500px; border-radius: 25px;">
        <div class="card-body">
            <i class="fa-solid fa-circle-check fa-5x text-success mb-4"></i>
            <h2 class="fw-bold text-uppercase">Xong rồi Hậu ơi!</h2>
            <p class="text-muted lead">Mật khẩu của bạn đã được thay đổi thành công.</p>
            <div class="mt-4">
                <a href="@Url.Action("Login", "Account")" class="btn btn-lg text-white px-5"
                   style="background-color: #ff8c00; border-radius: 15px; font-weight: bold;">ĐĂNG NHẬP NGAY</a>
            </div>
        </div>
    </div>
</div>