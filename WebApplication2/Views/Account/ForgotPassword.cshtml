@model WebApplication2.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Quên mật khẩu";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0" style="border-radius: 20px;">
                <div class="card-header text-center py-4 border-0" style="background-color: #333; color: #ff8c00;">
                    <h4 class="fw-bold mb-0 text-uppercase">Khôi phục mật khẩu</h4>
                </div>
                <div class="card-body p-5 bg-white text-center">
                    <p class="text-muted small mb-4">Nhập Email của bạn để nhận link đặt lại mật khẩu.</p>
                    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control border-0 bg-light py-3 text-center", style = "border-radius: 12px;", placeholder = "example@gmail.com" })
                        </div>
                        <button type="submit" class="btn btn-warning w-100 fw-bold py-3 text-white" style="border-radius: 12px; background-color: #ff8c00;">GỬI YÊU CẦU</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>