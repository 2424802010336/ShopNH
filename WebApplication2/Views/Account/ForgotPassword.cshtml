@model WebApplication2.Models.ForgotPasswordViewModel
@{ ViewBag.Title = "Quên mật khẩu"; }

<div class="container mt-5">
    <div class="card shadow border-0 mx-auto" style="max-width: 450px; border-radius: 25px;">
        <div class="card-body p-5 text-center">
            <div class="mb-4"><i class="fa-solid fa-envelope-open-text fa-4x" style="color: #ff8c00;"></i></div>
            <h4 class="fw-bold">LẤY LẠI MẬT KHẨU</h4>
            <p class="text-muted small mb-4">Nhập Email của bạn, chúng tôi sẽ gửi đường dẫn đặt lại mật khẩu ngay.</p>

            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control text-center mb-3", style = "border-radius: 10px; padding: 12px;", placeholder = "Email của bạn" })
                <div class="d-grid">
                    <button type="submit" class="btn text-white py-2" style="background-color: #ff8c00; border-radius: 10px; font-weight: bold;">GỬI LINK YÊU CẦU</button>
                </div>
            }
        </div>
    </div>
</div>