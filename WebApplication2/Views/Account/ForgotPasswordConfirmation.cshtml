@{ ViewBag.Title = "Đã gửi yêu cầu"; }

<div class="container mt-5 text-center">
    <div class="card shadow border-0 mx-auto py-5" style="max-width: 500px; border-radius: 25px;">
        <div class="card-body">
            <i class="fa-solid fa-paper-plane fa-5x text-success mb-4"></i>
            <h2 class="fw-bold">KIỂM TRA HÒM THƯ!</h2>
            <p class="text-muted lead px-4">Chúng tôi đã gửi một liên kết đặt lại mật khẩu vào Email của bạn. Hãy kiểm tra cả hộp thư rác nếu không thấy nhé.</p>
            <a href="@Url.Action("Login")" class="btn btn-outline-dark mt-4" style="border-radius: 10px;">Quay lại Đăng nhập</a>
        </div>
    </div>
</div>