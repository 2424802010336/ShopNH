    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
<script>
    function updateQty(id, delta) {
        $.ajax({
            url: '/Cart/UpdateQuantity',
            type: 'POST',
            data: { id: id, delta: delta },
            success: function (data) {
                if (data.success) {
                    // 1. Cập nhật Badge trên icon giỏ hàng
                    $('.cart-count-badge').text(data.newCount);

                    // 2. Tự động load lại Mini Cart dropdown
                    $('#mini-cart-content').load('/Cart/GetMiniCart');

                    // 3. Nếu đang ở trang giỏ hàng chính, load lại trang để cập nhật bảng giá
                    if (window.location.pathname.includes('/Cart')) {
                        location.reload();
                    }
                }
            },
            error: function () {
                toastr.error("Không thể kết nối đến máy chủ!");
            }
        });
    }
</script>
