@model IEnumerable<WebApplication2.Models.Order>
@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <h2 class="fw-bold mb-4" style="color: #ff8c00;">
        <i class="fa-solid fa-clock-rotate-left me-2"></i>LỊCH SỬ ĐƠN HÀNG
    </h2>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Mã ĐH</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            @* Tiêu đề cột chỉ để text, không để code liên quan đến item ở đây *@
                            <th class="text-center">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@item.Id</td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="text-danger fw-bold">@item.TotalAmount.ToString("N0") đ</span></td>
                                <td class="text-center">
                                    @if (item.Status == "Hoàn thành")
                                    {
                                        <span class="badge bg-success rounded-pill px-3">Đã giao hàng</span>
                                    }
                                    else if (item.Status == "Đã hủy")
                                    {
                                        <span class="badge bg-danger rounded-pill px-3">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3">@item.Status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Status == "Đã hủy")
                                    {
                                        <button onclick="reorder(@item.Id)" class="btn btn-sm btn-warning rounded-pill px-3 shadow-sm fw-bold">
                                            <i class="fa-solid fa-arrows-rotate me-1"></i> Đặt lại
                                        </button>
                                    }
                                    <a href="@Url.Action("MyOrderDetails", "Cart", new { id = item.Id })"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3 ms-1">
                                        Xem
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <i class="fa-solid fa-box-open fa-4x text-light mb-3"></i>
            <p class="text-muted fs-5">Bạn chưa có đơn hàng nào.</p>
            <a href="/" class="btn btn-warning text-white fw-bold px-4 rounded-pill">MUA SẮM NGAY</a>
        </div>
    }
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function reorder(oldId) {
            Swal.fire({
                title: 'Xác nhận đặt lại?',
                text: "Hệ thống sẽ tạo đơn hàng mới dựa trên các sản phẩm của đơn #" + oldId,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#ff8c00',
                cancelButtonColor: '#6e7881',
                confirmButtonText: 'Đồng ý đặt lại',
                cancelButtonText: 'Để sau'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Reorder", "Cart")',
                        type: 'POST',
                        data: { id: oldId },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    title: 'Thành công!',
                                    text: 'Đơn hàng mới #' + res.newOrderId + ' đã được tạo.',
                                    icon: 'success'
                                }).then(() => {
                                    location.reload(); // Load lại trang để thấy đơn mới ở trên đầu
                                });
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                            }
                        }
                    });
                }
            });
        }
    </script>
}