@model IEnumerable<WebApplication2.Models.CartItem>

<div class="p-2" style="max-height: 400px; overflow-y: auto; background-color: white;">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="d-flex align-items-center mb-3 border-bottom pb-2">
                <div style="width: 50px; height: 50px;" class="me-2">
                    <img src="@Url.Content(!string.IsNullOrEmpty(item.ImagePath) ? item.ImagePath : "/Content/Images/no-img.jpg")" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;">
                </div>
                <div style="flex-grow: 1;">
                    <div class="small fw-bold text-dark text-truncate" style="max-width: 150px;">@item.Title</div>
                    <div class="d-flex align-items-center mt-1">
                        <button type="button" onclick="updateQty(@item.ProductId, -1)" class="btn btn-xs btn-light border py-0 px-2 shadow-sm">-</button>
                        <span class="mx-2 small fw-bold">@item.Quantity</span>
                        <button type="button" onclick="updateQty(@item.ProductId, 1)" class="btn btn-xs btn-light border py-0 px-2 shadow-sm">+</button>
                        <span class="ms-2 small text-danger fw-bold">@((item.Price * item.Quantity).ToString("N0")) đ</span>
                    </div>
                </div>
                <a href="javascript:void(0)" onclick="updateQty(@item.ProductId, -@item.Quantity)" class="text-muted ms-2 p-1">
                    <i class="fa-solid fa-trash-can small"></i>
                </a>
            </div>
        }
        <div class="text-end fw-bold p-2 bg-light rounded shadow-sm mt-2">
            <span class="text-dark small">Tổng tiền:</span>
            <span class="text-danger fs-5">@Model.Sum(x => x.Price * x.Quantity).ToString("N0") đ</span>
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted">
            <i class="fa-solid fa-cart-shopping fa-3x mb-2 opacity-25"></i>
            <p class="small">Giỏ hàng đang trống</p>
        </div>
    }
</div>