@{
    ViewBag.Title = "Liên Hệ";
}

<div class="container py-5">
    <h2 class="fw-bold mb-4" style="color: #ff8c00;"><i class="fa-solid fa-map-location-dot"></i> THÔNG TIN LIÊN HỆ</h2>
    
    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 20px; background-color: #f8f9fa;">
                <address>
                    <strong class="fs-5 text-dark">Cửa hàng Sport Gear</strong><br />
                    <hr />
                    <p><i class="fa-solid fa-location-dot text-danger"></i> <strong>Địa chỉ:</strong> Thuận An, Bình Dương, Việt Nam</p>
                    <p><i class="fa-solid fa-phone text-success"></i> <strong>Hotline:</strong> 0123.456.789</p>
                    <p><i class="fa-solid fa-envelope" style="color: #ff8c00;"></i> <strong>Email:</strong> support@sportgear.vn</p>
                </address>

                <div class="mt-4 p-3 bg-white" style="border-radius: 15px; border-left: 5px solid #ff8c00;">
                    <h6 class="fw-bold text-uppercase small">Giờ mở cửa:</h6>
                    <p class="mb-0 small text-muted">Thứ 2 - Chủ Nhật: 08:00 - 22:00</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-7 mb-4">
            <div class="shadow-sm overflow-hidden" style="border-radius: 20px; height: 400px; border: 5px solid #fff;">
                <iframe 
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d62688.58316654519!2d106.66613380486847!3d10.884845558960613!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3174d6fe34808331%3A0x6331908b982163b!2zVGh14bqtbiBBbiwgQsOsbmggRMawxqFuZywgVmnhu4d0IE5hbQ!5e0!3m2!1svi!2s!4v1710000000000!5m2!1svi!2s" 
                    style="border:0; width: 100%; height: 100%;"
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </div>
</div>