@model WebApplication2.Models.SetPasswordViewModel
@{
    ViewBag.Title = "Thiết lập mật khẩu";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0" style="border-radius: 20px;">
                <div class="card-header text-white text-center py-3" style="background-color: #333; border-radius: 20px 20px 0 0;">
                    <h4 class="mb-0 fw-bold" style="color: #ff8c00;">TẠO MẬT KHẨU MỚI</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4 text-center">
                        <i class="fa-solid fa-circle-info"></i> Bạn chưa có mật khẩu cục bộ. Hãy tạo mới để có thể đăng nhập trực tiếp mà không cần dịch vụ bên ngoài.
                    </p>

                    @using (Html.BeginForm("SetPassword", "Manage", FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary("", new { @class = "text-danger small" })

                        <div class="mb-3">
                            <label class="fw-bold small text-muted">MẬT KHẨU MỚI</label>
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control shadow-sm", style = "border-radius: 10px;" })
                        </div>

                        <div class="mb-4">
                            <label class="fw-bold small text-muted">XÁC NHẬN MẬT KHẨU</label>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control shadow-sm", style = "border-radius: 10px;" })
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-lg text-white" style="background-color: #ff8c00; border-radius: 10px; font-weight: bold;">
                                LƯU MẬT KHẨU
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>