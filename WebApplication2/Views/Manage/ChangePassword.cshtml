@model WebApplication2.Models.ChangePasswordViewModel
@{ ViewBag.Title = "Đổi mật khẩu"; }

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0" style="border-radius: 20px;">
                <div class="card-header text-white text-center py-3" style="background-color: #ff8c00; border-radius: 20px 20px 0 0;">
                    <h4 class="mb-0 fw-bold">THAY ĐỔI MẬT KHẨU</h4>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary("", new { @class = "text-danger small" })

                        <div class="mb-3">
                            <label class="fw-bold small text-muted">Mật khẩu cũ</label>
                            @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control shadow-sm", style = "border-radius: 10px;" })
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold small text-muted">Mật khẩu mới</label>
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control shadow-sm", style = "border-radius: 10px;" })
                        </div>
                        <div class="mb-4">
                            <label class="fw-bold small text-muted">Xác nhận mật khẩu mới</label>
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control shadow-sm", style = "border-radius: 10px;" })
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-lg text-white" style="background-color: #ff8c00; border-radius: 10px;">CẬP NHẬT NGAY</button>
                            <a href="@Url.Action("Index")" class="btn btn-link text-muted">Hủy bỏ</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>