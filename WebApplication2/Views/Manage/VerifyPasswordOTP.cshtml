@{
    ViewBag.Title = "Xác nhận OTP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="card shadow-sm border-0 rounded-4 mx-auto p-5 text-center" style="max-width: 450px;">
        <div class="mb-3 text-warning"><i class="fa-solid fa-envelope-circle-check fa-3x"></i></div>
        <h3 class="fw-bold">Xác minh mã OTP</h3>
        <p class="text-muted small mb-4">Vui lòng nhập mã 6 số đã được gửi đến: <br /><b>@Request.QueryString["email"]</b></p>

        @using (Html.BeginForm("VerifyPasswordOTP", "Manage", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="text" name="otpInput" class="form-control form-control-lg text-center fw-bold rounded-3 mb-4 shadow-none" maxlength="6" placeholder="______" required autofocus />
            <button type="submit" class="btn btn-warning w-100 rounded-pill py-2 fw-bold shadow-sm">XÁC NHẬN MÃ</button>
        }
        <div class="mt-4 border-top pt-3">
            <a href="@Url.Action("Index")" class="text-decoration-none small text-muted">Hủy bỏ và quay lại</a>
        </div>
    </div>
</div>