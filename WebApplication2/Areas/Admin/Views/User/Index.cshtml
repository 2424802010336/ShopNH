@using WebApplication2.Models
@{
    ViewBag.Title = "Quản trị người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var admins = ViewBag.Admins as List<ApplicationUser> ?? new List<ApplicationUser>();
    var users = ViewBag.NormalUsers as List<ApplicationUser> ?? new List<ApplicationUser>();
}

<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold" style="color: #1e293b;"><i class="fa fa-shield-halved me-2 text-primary"></i>QUẢN TRỊ NGƯỜI DÙNG</h2>
        <hr />
    </div>

    <!-- BẢNG ADMIN -->
    <div class="card shadow-sm mb-5 border-0 rounded-4 overflow-hidden">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="m-0 fw-bold"><i class="fa fa-user-tie me-2"></i>DANH SÁCH QUẢN TRỊ VIÊN</h5>
            <a href="@Url.Action("CreateAdmin", "User")" class="btn btn-sm btn-success rounded-pill px-3">
                <i class="fa fa-plus me-1"></i> Thêm Admin mới
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tài khoản Admin</th>
                        <th class="text-center">Quyền hạn</th>
                        <th class="text-center">Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in admins)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">@item.Email</td>
                            <td class="text-center"><span class="badge bg-primary px-3 rounded-pill">Full Access</span></td>
                            <td class="text-center text-muted small">Quản trị viên toàn hệ thống</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- BẢNG NGƯỜI DÙNG -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header border-0 p-3" style="background: #334155; color: #cbd5e1;">
            <h5 class="m-0 fw-bold"><i class="fa fa-users me-2"></i>TÀI KHOẢN KHÁCH HÀNG</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Email</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thao tác quản lý</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in users)
                    {
                        bool isLocked = item.LockoutEndDateUtc > DateTime.UtcNow;
                        <tr>
                            <td class="ps-4">@item.Email</td>
                            <td class="text-center">
                                @if (isLocked)
                                {<span class="badge bg-danger rounded-pill"><i class="fa fa-lock me-1"></i>Bị Khóa</span> }
                                else
                                { <span class="badge bg-success rounded-pill"><i class="fa fa-check me-1"></i>Hoạt động</span>}
                            </td>
                            <td class="text-center">
                                <a href="@Url.Action("ToggleLock", new { id = item.Id })" class="btn btn-sm @(isLocked ? "btn-warning" : "btn-dark") rounded-pill px-3 me-2">
                                    <i class="fa @(isLocked ? "fa-key" : "fa-ban") me-1"></i> @(isLocked ? "Mở khóa" : "Khóa")
                                </a>
                                <a href="@Url.Action("DeleteUser", new { id = item.Id })" class="btn btn-sm btn-danger rounded-circle" onclick="return confirm('Xóa vĩnh viễn tài khoản này?')">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>