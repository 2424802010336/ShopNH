@model IEnumerable<WebApplication2.Models.ApplicationUser>
@{
    ViewBag.Title = "Quản lý Quản trị viên";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4 text-dark">
    @* Thông báo *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 p-3 rounded-4 shadow-sm" style="background: #1e293b; border-left: 6px solid #3b82f6;">
        <h4 class="fw-bold m-0 text-white"><i class="fa-solid fa-user-shield me-2 text-info"></i>DANH SÁCH ADMIN</h4>

        @* SỬA TẠI ĐÂY: Chuyển từ Modal sang chuyển hướng trang Create *@
        <a href="@Url.Action("Create", "User")" class="btn btn-info text-white rounded-pill px-4 fw-bold">
            <i class="fa fa-plus me-2"></i>Tạo tài khoản Admin
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="ps-4 py-3">Tài khoản Admin</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@user.Email</div>
                                <small class="text-muted">Quyền: Administrator</small>
                            </td>
                            <td>
                                @if (user.LockoutEndDateUtc > DateTime.UtcNow)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">Đang khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Hoạt động</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (user.Email != "admin@shopNH.com")
                                {
                                    <a href="@Url.Action("ToggleLock", "User", new { id = user.Id })"
                                       class="btn btn-sm @(user.LockoutEndDateUtc > DateTime.UtcNow ? "btn-warning" : "btn-outline-danger") rounded-pill px-3 fw-bold"
                                       onclick="return confirm('Xác nhận thay đổi trạng thái khóa tài khoản này?')">
                                        <i class="fa-solid @(user.LockoutEndDateUtc > DateTime.UtcNow ? "fa-unlock" : "fa-lock") me-1"></i>
                                        @(user.LockoutEndDateUtc > DateTime.UtcNow ? "Mở khóa" : "Khóa")
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Tài khoản gốc</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-info-subtle {
        background-color: #e0f2fe !important;
    }

    .bg-success-subtle {
        background-color: #dcfce7 !important;
    }

    .bg-danger-subtle {
        background-color: #fee2e2 !important;
    }

    .input-group-text {
        border-radius: 50rem 0 0 50rem !important;
    }

    .form-control {
        border-radius: 0 50rem 50rem 0 !important;
    }

        .form-control:focus {
            box-shadow: none;
            border-color: #dee2e6;
        }

    /* Hiệu ứng dòng bảng */
    .table-hover tbody tr:hover {
        background-color: #f8fafc !important;
        transition: all 0.2s;
    }

    /* Màu badge */
    .bg-info-subtle {
        background-color: #e0f2fe !important;
    }

    .bg-danger-subtle {
        background-color: #fee2e2 !important;
    }

    .bg-success-subtle {
        background-color: #dcfce7 !important;
    }
</style>