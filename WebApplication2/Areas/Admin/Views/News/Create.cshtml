@model WebApplication2.Models.News
@{
    ViewBag.Title = "Thêm tin tức";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-lg rounded-4">
    <div class="card-header bg-dark py-3">
        <h4 class="fw-bold m-0 text-white"><i class="fa-solid fa-plus me-2 text-primary"></i>TẠO TIN TỨC MỚI</h4>
    </div>
    <div class="card-body p-4">
        @* QUAN TRỌNG: Phải có tham số new { enctype = "multipart/form-data" } để upload file *@
        @using (Html.BeginForm("Create", "News", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="fw-bold mb-1">Tiêu đề bài viết</label>
                        @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control rounded-3", placeholder = "Nhập tiêu đề..." } })
                        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold mb-1">Mô tả ngắn</label>
                        @Html.TextAreaFor(model => model.ShortDescription, new { @class = "form-control rounded-3", rows = "3", placeholder = "Tóm tắt bài viết..." })
                        @Html.ValidationMessageFor(model => model.ShortDescription, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold mb-1">Nội dung chi tiết</label>
                        @Html.TextAreaFor(model => model.Content, new { @class = "form-control rounded-3", rows = "8", placeholder = "Nhập nội dung bài viết..." })
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary px-4 rounded-pill fw-bold">
                            <i class="fa-solid fa-save me-2"></i>Lưu bài viết
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-light px-4 rounded-pill border ms-2">Quay lại</a>
                    </div>
                </div>

                <div class="col-md-4">
                    @* MỤC CHỌN ẢNH VÀ XEM TRƯỚC *@
                    <div class="mb-3 text-center">
                        <label class="fw-bold mb-1 d-block text-start">Hình ảnh bài viết</label>
                        <div class="border rounded-4 p-2 bg-light mb-3" style="min-height: 200px; display: flex; align-items: center; justify-content: center;">
                            <img id="previewImg" src="https://placehold.co/400x300?text=Xem+truoc+anh" class="img-fluid rounded-4 shadow-sm" style="max-height: 250px; object-fit: cover;">
                        </div>
                        <input type="file" name="uploadImage" id="uploadImage" class="form-control rounded-pill" accept="image/*" onchange="previewFile(this)" />
                        <small class="text-muted d-block mt-2 text-start"><i class="fa-solid fa-circle-info me-1"></i>Nên chọn ảnh tỉ lệ 4:3 (ví dụ 800x600px).</small>
                    </div>

                    <div class="alert alert-info border-0 rounded-4">
                        <i class="fa-solid fa-circle-info me-2"></i> <b>Lưu ý:</b> Ngày tạo sẽ được hệ thống tự động cập nhật là thời điểm bạn nhấn nút lưu.
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        // Hàm để hiển thị ảnh xem trước ngay khi chọn file
        function previewFile(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#previewImg').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}