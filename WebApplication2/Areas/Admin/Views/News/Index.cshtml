@using PagedList.Mvc;
@model PagedList.IPagedList<WebApplication2.Models.News>

@{
    ViewBag.Title = "Quản lý Tin tức";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@* Thêm CSS cho phân trang đồng bộ với hệ thống *@
<style>
    .pagination-container {
        margin-top: 20px;
        margin-bottom: 20px;
        display: flex;
        justify-content: center;
    }

    .pagination {
        display: flex;
        list-style: none;
        padding: 0;
    }

    .page-item .page-link {
        border: none;
        margin: 0 3px;
        border-radius: 8px !important;
        color: #4b5563;
        background: #f3f4f6;
        padding: 8px 16px;
        font-weight: 600;
        transition: all 0.3s;
        text-decoration: none;
    }

    .page-item.active .page-link {
        background: #ff8c00 !important;
        color: white !important;
        box-shadow: 0 4px 10px rgba(255, 140, 0, 0.3);
    }

    .page-item:hover .page-link:not(.active) {
        background: #e5e7eb;
        transform: translateY(-2px);
    }

    .table-container {
        overflow: hidden;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    @* --- Header của Card: Chỉnh lại để chứa thanh tìm kiếm --- *@
    <div class="card-header bg-white py-3 border-bottom">
        <div class="row align-items-center">
            <div class="col-md-4">
                <h5 class="fw-bold m-0 text-dark">
                    <i class="fa-solid fa-newspaper me-2 text-primary"></i>DANH SÁCH TIN TỨC
                </h5>
            </div>
            <div class="col-md-5">
                @using (Html.BeginForm("Index", "News", FormMethod.Get, new { @class = "d-flex" }))
                {
                    <div class="input-group">
                        <input type="text" name="searchString" value="@Request.QueryString["searchString"]"
                               class="form-control rounded-pill-start border-secondary ps-3"
                               placeholder="Tìm tiêu đề tin tức...">
                        <button class="btn btn-dark rounded-pill-end px-3" type="submit">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                }
            </div>
            <div class="col-md-3 text-end">
                <a href="@Url.Action("Create")" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                    <i class="fa-solid fa-plus me-2"></i>Thêm bài viết
                </a>
            </div>
        </div>
    </div>

    @* --- Thân Card --- *@
    <div class="card-body p-0">
        <div class="table-responsive table-container">
            <table class="table table-hover align-middle mb-0" style="table-layout: fixed; width: 100%;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 120px;">Ảnh bìa</th>
                        <th>Nội dung bài viết</th>
                        <th style="width: 180px;">Thời gian đăng</th>
                        <th class="text-center" style="width: 160px;">Tùy chọn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="rounded-3 border shadow-sm bg-light d-flex align-items-center justify-content-center"
                                         style="width: 90px; height: 60px; overflow: hidden;">
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="@Url.Content(item.ImagePath)"
                                                 class="w-100 h-100" style="object-fit: cover;"
                                                 onerror="this.src='https://placehold.co/90x60?text=No+Image'">
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-image text-muted"></i>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark mb-1 text-truncate" title="@item.Title">
                                        @item.Title
                                    </div>
                                    <div class="text-muted small text-truncate-2">
                                        @item.ShortDescription
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="small fw-bold text-dark">
                                            <i class="fa-regular fa-calendar-check me-1 text-secondary"></i>
                                            @item.CreatedDate.ToString("dd/MM/yyyy")
                                        </span>
                                        <span class="text-muted" style="font-size: 0.75rem;">
                                            <i class="fa-regular fa-clock me-1"></i> @item.CreatedDate.ToString("HH:mm")
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center pe-3">
                                    <div class="btn-group shadow-sm border rounded-pill bg-white px-2">
                                        <a href="@Url.Action("Edit", "News", new { area = "Admin", id = item.Id })"
                                           class="btn btn-link btn-sm text-primary p-2" title="Sửa nội dung">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <a href="@Url.Action("Details", "News", new { area = "Admin", id = item.Id })"
                                           class="btn btn-link btn-sm text-info p-2" title="Xem chi tiết">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", "News", new { area = "Admin", id = item.Id })"
                                           class="btn btn-link btn-sm text-danger p-2" title="Xóa bài">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                Không tìm thấy bài viết nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Hiển thị phân trang *@
        <div class="pagination-container">
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchString = Request.QueryString["searchString"] }),
                new PagedListRenderOptions
                     {
                    LiElementClasses = new string[] { "page-item" },
                    UlElementClasses = new string[] { "pagination" }
                })
        </div>
    </div>
</div>