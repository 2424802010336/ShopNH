@model WebApplication2.Models.Book
@{
    ViewBag.Title = "Chỉnh sửa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-lg border-0 rounded-4 p-4">
    <h2 class="fw-bold text-primary mb-4 text-uppercase"><i class="fa-solid fa-pen-to-square"></i> Chỉnh sửa sản phẩm</h2>

    @using (Html.BeginForm("Edit", "Books", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.ImagePath)

        <div class="row">
            @* CỘT TRÁI: THÔNG TIN CHI TIẾT *@
            <div class="col-md-8">
                <div class="mb-3">
                    <label class="fw-bold">Tên sản phẩm</label>
                    @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Chọn danh mục chính</label>
                        <select name="CategoryGroup" id="CategoryGroup" class="form-select border-primary fw-bold" onchange="toggleFields()" required>
                            <option value="Vot" @(Model.Category != null && Model.Category.Contains("Vot") ? "selected" : "")>Vợt cầu lông</option>
                            <option value="Giay" @(Model.Category != null && Model.Category.Contains("Giay") ? "selected" : "")>Giày cầu lông</option>
                            <option value="Ao" @(Model.Category != null && Model.Category.Contains("Ao") ? "selected" : "")>Áo cầu lông</option>
                            <option value="Quan" @(Model.Category != null && Model.Category.Contains("Quan") ? "selected" : "")>Quần cầu lông</option>
                            <option value="Vay" @(Model.Category != null && Model.Category.Contains("Vay") ? "selected" : "")>Váy cầu lông</option>
                            <option value="TuiVot" @(Model.Category != null && Model.Category.Contains("Tui") ? "selected" : "")>Túi vợt</option>
                            <option value="Balo" @(Model.Category != null && Model.Category.Contains("Balo") ? "selected" : "")>Balo cầu lông</option>
                            <option value="PhuKien" @(Model.Category != null && (Model.Category == "Vo" || Model.Category == "QuanCan" || Model.Category == "QuaCau" || Model.Category == "Cuoc" || Model.Category == "ChanMoHoi")) ? "selected" : "" )>Phụ kiện</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3" id="brand-area">
                        <label class="fw-bold">Thương hiệu</label>
                        <select name="Brand" id="Brand" class="form-select border-primary">
                            @foreach (var b in new[] { "Yonex", "Lining", "VS", "Victor", "Mizuno" })
                            {
                                <option value="@b" @(Model.Category != null && Model.Category.Contains(b) ? "selected" : "")>@b</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3" id="sub-category-area" style="display:none;">
                        <label class="fw-bold text-success">Phân loại chi tiết</label>
                        <select name="SubCategory" id="SubCategory" class="form-select border-success fw-bold">
                            @* JS render dựa theo Category hiện tại *@
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold">Giá niêm yết (đ)</label>
                        @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold text-danger">Giá khuyến mãi (đ)</label>
                        @Html.EditorFor(model => model.SalePrice, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                    </div>
                </div>

                @* KHU VỰC THÔNG SỐ RIÊNG *@
                <div id="fields-vot" class="extra-fields border p-3 rounded-3 mb-3 shadow-sm" style="display:none; background: #f8f9fa;">
                    <h6 class="text-primary fw-bold">THÔNG SỐ VỢT</h6>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="small fw-bold">Trọng lượng</label>
                            @Html.EditorFor(model => model.Weight, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="small fw-bold">Swingweight</label>
                            @Html.EditorFor(model => model.SwingWeight, new { htmlAttributes = new { @class = "form-control" } })
                        </div>
                    </div>
                </div>

                <div id="fields-size" class="extra-fields border p-3 rounded-3 mb-3 shadow-sm" style="display:none; background: #f8f9fa;">
                    <h6 class="text-primary fw-bold">SIZE SẢN PHẨM</h6>
                    @Html.EditorFor(model => model.SizeList, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div id="fields-form-giay" class="extra-fields border p-3 rounded-3 mb-3 shadow-sm" style="display:none; background: #fff3e0;">
                    <h6 class="text-warning fw-bold">FORM GIÀY</h6>
                    <select name="FormType" class="form-select">
                        <option value="Unisex" @(Model.FormType == "Unisex" ? "selected" : "")>Unisex</option>
                        <option value="Slim" @(Model.FormType == "Slim" ? "selected" : "")>Slim</option>
                        <option value="Wide" @(Model.FormType == "Wide" ? "selected" : "")>Wide</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="fw-bold">Mô tả sản phẩm</label>
                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 5 })
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow">CẬP NHẬT NGAY</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg px-4 ms-2">Hủy bỏ</a>
                </div>
            </div>

            @* CỘT PHẢI: HÌNH ẢNH *@
            <div class="col-md-4 text-center">
                <label class="fw-bold d-block mb-2">Hình ảnh hiện tại</label>
                <div class="border rounded-4 p-2 mb-3 bg-light" style="min-height: 300px; display: flex; align-items: center; justify-content: center;">
                    <img id="previewImg" src="@Url.Content(Model.ImagePath)" class="img-fluid rounded-4 shadow-sm" style="max-height: 350px;" onerror="this.src='/Content/Images/no-image.png'">
                </div>
                <input type="file" name="uploadImage" class="form-control" onchange="previewFile(this)">
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        $(document).ready(function() { toggleFields(); });

        function toggleFields() {
            var cat = document.getElementById("CategoryGroup").value;
            var subArea = document.getElementById("sub-category-area");
            var subSelect = document.getElementById("SubCategory");
            var brandArea = document.getElementById("brand-area");

            $(".extra-fields").hide();
            subArea.style.display = 'none';
            brandArea.style.display = 'block';

            if (cat === "Vot") { $("#fields-vot").show(); }
            else if (cat === "Giay") { $("#fields-size, #fields-form-giay").show(); }
            else if (["Ao", "Quan", "Vay"].includes(cat)) { $("#fields-size").show(); }
            else if (cat === "TuiVot") {
                subArea.style.display = 'block';
                subSelect.innerHTML = '<option value="NgangVai">Đeo ngang vai</option><option value="TrenLung">Đeo trên lưng</option>';
            }
            else if (cat === "PhuKien") {
                brandArea.style.display = 'none';
                subArea.style.display = 'block';
                subSelect.innerHTML = `
                    <option value="Vo" @(Model.Category == "Vo" ? "selected" : "")>Vớ cầu lông</option>
                    <option value="QuanCan" @(Model.Category == "QuanCan" ? "selected" : "")>Quấn cán vợt</option>
                    <option value="QuaCau" @(Model.Category == "QuaCau" ? "selected" : "")>Quả cầu lông</option>
                    <option value="Cuoc" @(Model.Category == "Cuoc" ? "selected" : "")>Cước căng vợt</option>
                    <option value="ChanMoHoi" @(Model.Category == "ChanMoHoi" ? "selected" : "")>Băng chặn mồ hôi</option>`;
            }
        }

        function previewFile(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) { document.getElementById("previewImg").src = e.target.result; }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}