@model WebApplication2.Models.Book
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="card shadow-lg border-0" style="border-radius: 25px; overflow: hidden; background: #fff;">
        <div class="row g-0">
            @* BÊN TRÁI: ẢNH *@
            <div class="col-md-5 d-flex align-items-center justify-content-center p-4" style="background: #fdfdfd; border-right: 1px solid #f1f1f1;">
                <img src="@Url.Content(Model.ImagePath)" class="img-fluid rounded-4" style="max-height: 450px; transition: 0.3s;" onerror="this.src='/Content/Images/no-image.png'">
            </div>

            @* BÊN PHẢI: THÔNG TIN *@
            <div class="col-md-7">
                <div class="card-body p-5">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill mb-2 text-uppercase">@Model.Category</span>
                            <h1 class="fw-bold text-dark display-6">@Model.Title</h1>
                        </div>
                    </div>

                    <div class="my-4">
                        @if (Model.SalePrice.HasValue && Model.SalePrice > 0)
                        {
                            <span class="h4 text-muted text-decoration-line-through me-3">@String.Format("{0:0,0}", Model.Price) đ</span>
                            <span class="h2 text-danger fw-bold">@String.Format("{0:0,0}", Model.SalePrice) đ</span>
                        }
                        else
                        {
                            <span class="h2 text-danger fw-bold">@String.Format("{0:0,0}", Model.Price) đ</span>
                        }
                    </div>

                    <div class="p-4 bg-light rounded-4 mb-4 border-0 shadow-sm">
                        <h6 class="fw-bold mb-3 text-primary text-uppercase"><i class="fa-solid fa-circle-info me-2"></i>Thông số kỹ thuật</h6>
                        <div class="row g-3">
                            @if (Model.Category != null && Model.Category.Contains("Vot"))
                            {
                                <div class="col-6"><strong>Trọng lượng:</strong> <br /> <span class="text-secondary">@(Model.Weight ?? "N/A")</span></div>
                                <div class="col-6"><strong>Swingweight:</strong> <br /> <span class="text-secondary">@(Model.SwingWeight ?? "N/A")</span></div>
                                <div class="col-6"><strong>Chiều dài cán:</strong> <br /> <span class="text-secondary">@(Model.HandleLength ?? "N/A")</span></div>
                            }
                            @if (Model.Category != null && (Model.Category.Contains("Giay") || Model.Category.Contains("Ao") || Model.Category.Contains("Quan") || Model.Category.Contains("Vay")))
                            {
                                <div class="col-6"><strong>Size sẵn có:</strong> <br /> <span class="text-secondary">@(Model.SizeList ?? "N/A")</span></div>
                                if (Model.Category.Contains("Giay"))
                                {
                                    <div class="col-6"><strong>Form chân:</strong> <br /> <span class="text-secondary">@(Model.FormType ?? "N/A")</span></div>
                                }
                            }
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold text-dark">Mô tả bài viết:</h6>
                        <p class="text-muted" style="white-space: pre-line; line-height: 1.6;">@Model.Description</p>
                    </div>

                    <div class="pt-4 border-top">
                        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning text-white fw-bold px-5 py-2 rounded-pill shadow-sm">
                            <i class="fa-solid fa-pen-to-square"></i> CHỈNH SỬA
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4 py-2 rounded-pill ms-2">
                            <i class="fa-solid fa-arrow-left"></i> QUAY LẠI
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>