@model WebApplication2.Models.Book
@{ ViewBag.Title = "Xác nhận xóa sản phẩm"; }

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-lg border-0 p-5" style="border-radius: 30px;">
                <div class="text-danger mb-4">
                    <i class="fa-solid fa-triangle-exclamation fa-5x animate__animated animate__pulse animate__infinite"></i>
                </div>
                <h2 class="fw-bold text-dark">BẠN CÓ CHẮC CHẮN?</h2>
                <p class="text-muted mb-4">Dữ liệu của sản phẩm này sẽ bị xóa vĩnh viễn và không thể phục hồi.</p>

                <div class="alert alert-light border rounded-4 d-flex align-items-center p-3 mb-4">
                    <img src="@Url.Content(Model.ImagePath)" class="rounded-3 shadow-sm me-3" style="width: 80px; height: 80px; object-fit: cover;" onerror="this.src='/Content/Images/no-image.png'">
                    <div class="text-start">
                        <div class="fw-bold text-dark">@Model.Title</div>
                        <div class="small text-danger fw-bold">@String.Format("{0:0,0}", Model.Price) đ</div>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.Id)
                    <div class="d-grid gap-2 d-md-flex justify-content-center">
                        <button type="submit" class="btn btn-danger btn-lg px-5 fw-bold rounded-pill shadow">XÁC NHẬN XÓA</button>
                        <a href="@Url.Action("Index")" class="btn btn-light btn-lg px-5 rounded-pill border">HỦY BỎ</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>