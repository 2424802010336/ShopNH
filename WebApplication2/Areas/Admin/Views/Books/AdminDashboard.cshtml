@{
    ViewBag.Title = "Bảng điều khiển";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <!-- Top Welcome Banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-5 rounded-5 shadow-sm text-white" style="background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);">
                <h1 class="fw-bold mb-2"><i class="fa-solid fa-chart-line me-2"></i> Admin Dashboard</h1>
                <p class="fs-5 opacity-75 mb-0">Quản lý toàn bộ hệ thống bán hàng SHOP NH</p>
            </div>
        </div>
    </div>

    <!-- Stats Cards Row -->
    <div class="row g-4 mb-4">
        @* SỬA LỖI TẠI ĐÂY: Thêm dấu @{ để bắt đầu khối code C# *@
        @{
            var revenueDisplay = string.Format("{0:N0} đ", ViewBag.TotalRevenue ?? 0);
            var cards = new dynamic[] {
                new { Label = "Tổng sản phẩm", Val = (ViewBag.TotalProducts ?? 0).ToString(), Icon = "fa-box", Color = "#4e73df", Desc = "Trong kho" },
                new { Label = "Người dùng", Val = (ViewBag.TotalUsers ?? 0).ToString(), Icon = "fa-users", Color = "#1cc88a", Desc = "Đã đăng ký" },
                new { Label = "Đơn hàng", Val = (ViewBag.TotalOrders ?? 0).ToString(), Icon = "fa-shopping-cart", Color = "#f6c23e", Desc = "Đã tạo" },
                new { Label = "Tổng doanh thu", Val = revenueDisplay, Icon = "fa-dollar-sign", Color = "#e74a3b", Desc = "Đã giao hàng" }
            };
        }

        @foreach (var card in cards)
        {
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="text-muted small fw-bold text-uppercase mb-1">@card.Label</div>
                            <h3 class="fw-bold mb-1 text-truncate" style="max-width: 180px;">@card.Val</h3>
                            <div class="small text-secondary">@card.Desc</div>
                        </div>
                        <div class="p-3 rounded-4 d-flex align-items-center justify-content-center" style="background: rgba(0,0,0,0.03); color: @card.Color; width: 60px; height: 60px;">
                            <i class="fa-solid @card.Icon fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Charts Row -->
    <div class="row g-4">
        <!-- Biểu đồ phân bổ -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-5 p-4 bg-white h-100">
                <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-chart-pie me-2"></i> Phân Bổ Danh Mục</h5>
                <canvas id="catChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
        <!-- Biểu đồ doanh thu/trạng thái -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-5 p-4 bg-white h-100">
                <h5 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-list-ul me-2"></i> Trạng Thái Đơn Hàng</h5>
                <canvas id="orderBarChart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Phân bổ danh mục
        new Chart(document.getElementById('catChart'), {
            type: 'doughnut',
            data: {
                labels: ['Vợt Cầu Lông', 'Giày', 'Áo Quần', 'Phụ kiện'],
                datasets: [{
                    data: [45, 25, 20, 10],
                    backgroundColor: ['#6366f1', '#1cc88a', '#36b9cc', '#f6c23e'],
                    borderWidth: 0,
                    hoverOffset: 20
                }]
            },
            options: { cutout: '70%', plugins: { legend: { position: 'bottom' } } }
        });

        // Trạng thái đơn hàng
        new Chart(document.getElementById('orderBarChart'), {
            type: 'bar',
            data: {
                labels: ['Chờ duyệt', 'Đang xử lý', 'Đã giao', 'Đã hủy'],
                datasets: [{
                    label: 'Đơn hàng',
                    data: [1, 1, 18, 1],
                    backgroundColor: ['#f6c23e', '#4e73df', '#1cc88a', '#e74a3b'],
                    borderRadius: 10
                }]
            },
            options: { indexAxis: 'y', plugins: { legend: { display: false } } }
        });
    </script>
}