@{
    ViewBag.Title = "Bảng điều khiển";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Top Welcome Banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-5 rounded-4 shadow-sm text-white border-0" style="background: linear-gradient(135deg, #1e293b 0%, #334155 100%); border-left: 8px solid #3b82f6 !important;">
                <h1 class="fw-bold mb-2"><i class="fa-solid fa-chart-line me-2 text-info"></i> Admin Dashboard</h1>
                <p class="fs-5 opacity-75 mb-0">Hệ thống quản trị SHOP NH - Chúc bạn một ngày làm việc hiệu quả!</p>
            </div>
        </div>
    </div>

    <!-- Stats Cards Row -->
    <div class="row g-4 mb-4">
        @{
            var revenueDisplay = string.Format("{0:N0} đ", ViewBag.TotalRevenue ?? 0);
            var cards = new dynamic[] {
                new { Label = "Sản phẩm", Val = (ViewBag.TotalProducts ?? 0).ToString(), Icon = "fa-box", Color = "#3b82f6", Bg = "#dbeafe", Desc = "Trong kho" },
                new { Label = "Khách hàng", Val = (ViewBag.TotalUsers ?? 0).ToString(), Icon = "fa-users", Color = "#10b981", Bg = "#d1fae5", Desc = "Đã đăng ký" },
                new { Label = "Đơn hàng", Val = (ViewBag.TotalOrders ?? 0).ToString(), Icon = "fa-cart-shopping", Color = "#f59e0b", Bg = "#fef3c7", Desc = "Tổng đơn" },
                new { Label = "Doanh thu", Val = revenueDisplay, Icon = "fa-sack-dollar", Color = "#ef4444", Bg = "#fee2e2", Desc = "Thành công" }
            };
        }

        @foreach (var card in cards)
        {
            <div class="col-xl-3 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white hover-up">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small fw-bold text-uppercase mb-1" style="letter-spacing: 0.5px;">@card.Label</div>
                            <h3 class="fw-bold mb-1 text-dark">@card.Val</h3>
                            <div class="small text-secondary"><i class="fa-solid fa-clock-rotate-left me-1"></i>@card.Desc</div>
                        </div>
                        <div class="p-3 rounded-4 d-flex align-items-center justify-content-center shadow-sm" style="background: @card.Bg; color: @card.Color; width: 55px; height: 55px;">
                            <i class="fa-solid @card.Icon fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Charts Row -->
    <div class="row g-4">
        <!-- Biểu đồ phân bổ -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="p-2 bg-primary-subtle rounded-3 me-3">
                        <i class="fa-solid fa-chart-pie text-primary"></i>
                    </div>
                    <h5 class="fw-bold m-0 text-dark">Phân Bổ Danh Mục</h5>
                </div>
                <div class="chart-container" style="position: relative; height:300px;">
                    <canvas id="catChart"></canvas>
                </div>
            </div>
        </div>
        <!-- Biểu đồ trạng thái -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="p-2 bg-success-subtle rounded-3 me-3">
                        <i class="fa-solid fa-list-check text-success"></i>
                    </div>
                    <h5 class="fw-bold m-0 text-dark">Trạng Thái Đơn Hàng</h5>
                </div>
                <div class="chart-container" style="position: relative; height:300px;">
                    <canvas id="orderBarChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-up {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hover-up:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .bg-primary-subtle {
        background-color: #e0e7ff !important;
    }

    .bg-success-subtle {
        background-color: #d1fae5 !important;
    }
</style>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Cấu hình chung cho Chart.js
        Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";

        // 1. BIỂU ĐỒ TRÒN (PHÂN BỔ DANH MỤC)
        new Chart(document.getElementById('catChart'), {
            type: 'doughnut',
            data: {
                labels: ['Vợt Cầu Lông', 'Giày', 'Áo Quần', 'Phụ kiện'],
                datasets: [{
                    data: [@ViewBag.Cat_Vot, @ViewBag.Cat_Giay, @ViewBag.Cat_AoQuan, @ViewBag.Cat_PhuKien],
                    backgroundColor: ['#3b82f6', '#10b981', '#06b6d4', '#f59e0b'],
                    borderWidth: 5,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                maintainAspectRatio: false,
                cutout: '75%',
                plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } } }
            }
        });

        // 2. BIỂU ĐỒ BAR (TRẠNG THÁI ĐƠN HÀNG)
        new Chart(document.getElementById('orderBarChart'), {
            type: 'bar',
            data: {
                // Chỉ giữ lại 3 trạng thái theo yêu cầu
                labels: ['Chờ duyệt', 'Đã giao', 'Đã hủy'],
                datasets: [{
                    data: [@ViewBag.Status_ChoDuyet, @ViewBag.Status_DaGiao, @ViewBag.Status_DaHuy],
                    backgroundColor: ['#f59e0b', '#10b981', '#ef4444'],
                    borderRadius: 8,
                    barThickness: 25
                }]
            },
            options: {
                indexAxis: 'y',
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: {
                        beginAtZero: true,
                        grid: { display: false },
                        ticks: {
                            stepSize: 1,
                            precision: 0,
                            callback: function(value) {
                                if (value % 1 === 0) { return value; }
                            }
                        }
                    },
                    y: { grid: { display: false } }
                }
            }
        });
    </script>
}