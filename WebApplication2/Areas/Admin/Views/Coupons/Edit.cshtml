@model WebApplication2.Models.Coupon
@{
    ViewBag.Title = "Chỉnh sửa Voucher";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-5 overflow-hidden">
                <!-- Header Card (Màu cam/tím để phân biệt với trang Create) -->
                <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                    <h3 class="fw-bold m-0"><i class="fa-solid fa-pen-to-square me-2"></i>CHỈNH SỬA VOUCHER</h3>
                    <p class="small opacity-75 mb-0">Cập nhật thông tin mã giảm giá: @Model.Code</p>
                </div>

                <div class="card-body p-4 p-lg-5 bg-white">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

                        @* Quan trọng: Phải có Id để hệ thống biết đang sửa Voucher nào *@
                        @Html.HiddenFor(model => model.Id)
                        @Html.HiddenFor(model => model.IsActive)

                        <!-- Mã Code -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark"><i class="fa-solid fa-barcode me-2"></i>Mã Voucher</label>
                            @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @class = "form-control form-control-lg rounded-3 shadow-none", placeholder = "VD: SALE2026..." } })
                            @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Phần trăm giảm -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark"><i class="fa-solid fa-percent me-2"></i>Phần trăm giảm giá (%)</label>
                            @Html.EditorFor(model => model.DiscountPercent, new { htmlAttributes = new { @class = "form-control form-control-lg rounded-3 shadow-none", type = "number", min = "1", max = "100" } })
                            @Html.ValidationMessageFor(model => model.DiscountPercent, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Ngày hết hạn -->
                        <div class="mb-5">
                            <label class="form-label fw-bold text-dark"><i class="fa-solid fa-calendar-day me-2"></i>Ngày hết hạn</label>
                            @* Định dạng yyyy-MM-dd để ô input type="date" nhận giá trị từ database *@
                            @Html.TextBoxFor(model => model.ExpiryDate, "{0:yyyy-MM-dd}", new { @class = "form-control form-control-lg rounded-3 shadow-none", type = "date" })
                            @Html.ValidationMessageFor(model => model.ExpiryDate, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Nút hành động -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg rounded-pill fw-bold text-white shadow-sm">
                                <i class="fa-solid fa-save me-2"></i>LƯU THAY ĐỔI
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-light btn-lg rounded-pill fw-bold text-muted">
                                Hủy bỏ
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #f59e0b;
        background-color: #fffbeb;
    }

    .btn-warning {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        border: none;
        transition: 0.3s;
    }

        .btn-warning:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(245, 158, 11, 0.4) !important;
            color: white;
        }
</style>