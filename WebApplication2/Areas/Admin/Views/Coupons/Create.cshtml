@model WebApplication2.Models.Coupon
@{
    ViewBag.Title = "Tạo Voucher Mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-5 overflow-hidden">
                <!-- Header Card -->
                <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);">
                    <h3 class="fw-bold m-0"><i class="fa-solid fa-ticket-simple me-2"></i>TẠO VOUCHER MỚI</h3>
                    <p class="small opacity-75 mb-0">Thiết lập mã giảm giá cho cửa hàng của bạn</p>
                </div>

                <div class="card-body p-4 p-lg-5 bg-white">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

                        <!-- Mã Code -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark"><i class="fa-solid fa-barcode me-2"></i>Mã Voucher</label>
                            @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @class = "form-control form-control-lg rounded-3 shadow-none", placeholder = "VD: SALE2026, TET2026..." } })
                            @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Phần trăm giảm -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark"><i class="fa-solid fa-percent me-2"></i>Phần trăm giảm giá (%)</label>
                            @Html.EditorFor(model => model.DiscountPercent, new { htmlAttributes = new { @class = "form-control form-control-lg rounded-3 shadow-none", type = "number", min = "1", max = "100" } })
                            @Html.ValidationMessageFor(model => model.DiscountPercent, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Ngày hết hạn -->
                        <div class="mb-5">
                            <label class="form-label fw-bold text-dark"><i class="fa-solid fa-calendar-day me-2"></i>Ngày hết hạn</label>
                            @Html.EditorFor(model => model.ExpiryDate, new { htmlAttributes = new { @class = "form-control form-control-lg rounded-3 shadow-none", type = "date" } })
                            @Html.ValidationMessageFor(model => model.ExpiryDate, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Nút hành động -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                <i class="fa-solid fa-check-circle me-2"></i>XÁC NHẬN TẠO
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-light btn-lg rounded-pill fw-bold text-muted">
                                Quay lại danh sách
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #6366f1;
        background-color: #f8fafc;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        border: none;
        transition: 0.3s;
    }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(99, 102, 241, 0.4) !important;
        }
</style>